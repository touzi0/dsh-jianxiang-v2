{
  "name": "dsh-plugin-entry",
  "version": "1.0.0",
  "description": "把官方的「插件」入口从侧边栏挪进设置：设置里多一个「插件管理」标签页（点开官方插件管理页），侧栏那行隐藏；原「内置插件」分区改名「内置组件」",
  "type": "module",
  "private": true,
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "jx": {
    "description": "插件入口搬家：侧栏「新建会话」下面那行「插件」隐藏，改成设置 → 插件 → 「插件管理」标签页；原「内置插件」分区同时改名「内置组件」",
    "defaultEnabled": true
  }
}
