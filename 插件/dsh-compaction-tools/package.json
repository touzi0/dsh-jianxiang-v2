{
  "name": "dsh-compaction-tools",
  "version": "1.0.0",
  "description": "模型自主上下文压缩（原生）：4 个模型工具骑官方 compaction 引擎，压缩标记与摘要直接出现在会话流",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "jx": {
    "description": "模型自主压缩（原生引擎）：compress/status/search_history/restore 四工具；压缩后在会话流出现官方标记行（可展开摘要），原文在界面永不消失；并重新启用官方压缩三件套（含自动压力压缩与手动 /compact）",
    "defaultEnabled": true,
    "config": {
      "retainRatio": 0.25,
      "minCompressTokens": 2000,
      "restoreByteCap": 24000,
      "searchMaxResults": 8
    },
    "overrides": [
      { "id": "compaction-basic", "disabled": false },
      { "id": "command-compact", "disabled": false },
      { "id": "tool-result-pruner", "disabled": false }
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-token-meter": "*"
  },
  "scripts": {
    "build": "node build.mjs"
  }
}
